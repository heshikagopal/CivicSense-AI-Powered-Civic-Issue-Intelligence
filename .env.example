# CivicSense Environment Configuration Template

# Server & Security
PROJECT_NAME="CivicSense – AI-Powered Civic Issue Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="civicsense-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default Local Standalone Mode (Zero external dependencies):
DATABASE_URL="sqlite:///./civicsense.db"
# Production PostgreSQL + PostGIS Mode:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/civicsense"

# Storage
UPLOAD_DIR="./backend/uploads"
MAX_UPLOAD_SIZE_MB=15

# Machine Learning & Duplicate Thresholds
MODEL_WEIGHTS_PATH="./ml/weights/yolo11_civic.pt"
DUPLICATE_AUTO_MERGE_THRESHOLD=0.85
DUPLICATE_MANUAL_REVIEW_THRESHOLD=0.65
DUPLICATE_SEARCH_RADIUS_METERS=150.0
